import assert from "node:assert/strict";import { clientIp,forwardedClientIp,normalizeIp,proxyIsTrusted } from "../lib/clientIp";
const forged=new Headers({"cf-connecting-ip":"203.0.113.9","x-forwarded-for":"198.51.100.7","x-real-ip":"192.0.2.4"});assert.equal(forwardedClientIp(forged,false),"unknown","direct clients cannot assert forwarded identity");assert.equal(forwardedClientIp(forged,true),"203.0.113.9","trusted Cloudflare value wins");const xff=new Headers({"x-forwarded-for":"198.51.100.7, 10.0.0.2"});assert.equal(forwardedClientIp(xff,true),"198.51.100.7");assert.equal(forwardedClientIp(new Headers({"x-forwarded-for":"not-an-ip"}),true),"unknown");assert.equal(normalizeIp("::ffff:192.0.2.8"),"192.0.2.8");assert.equal(proxyIsTrusted(new Headers({"x-origin-proxy-secret":"correct"}),"correct"),true);assert.equal(proxyIsTrusted(new Headers({"x-origin-proxy-secret":"wrong"}),"correct"),false);assert.equal(clientIp(new Request("http://localhost",{headers:{"x-client-ip":"203.0.113.1"}})),"203.0.113.1");assert.equal(clientIp(new Request("http://localhost",{headers:{"x-client-ip":"bad"}})),"unknown");console.log("client IP trust tests passed");
