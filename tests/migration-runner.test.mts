const dir=await mkdtemp(path.join(os.tmpdir(),"migrations-"));await Promise.all([writeFile(path.join(dir,"002_second.sql"),"select 2;\n"),writeFile(path.join(dir,"001_first.sql"),"select 1;\n"),writeFile(path.join(dir,"bad.sql"),"select 0;\n")]);const names=(await import("node:fs/promises")).readdir(dir).then(xs=>xs.filter(x=>/^\d{3}_[a-z0-9_]+\.sql$/.test(x)).sort());assert.deepEqual(await names,["001_first.sql","002_second.sql"]);const body=await readFile(path.join(dir,"001_first.sql"),"utf8"),checksum=createHash("sha256").update(body).digest("hex");assert.equal(checksum.length,64);assert.notEqual(checksum,createHash("sha256").update(body+" ").digest("hex"));const runner=await readFile(new URL("../scripts/migrate.mjs",import.meta.url),"utf8");assert.match(runner,/pg_advisory_lock/);assert.match(runner,/Checksum mismatch/);assert.match(runner,/begin/);assert.match(runner,/rollback/);assert.match(runner,/--baseline/);console.log("migration runner tests passed");
