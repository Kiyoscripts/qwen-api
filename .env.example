# Copy to .env.local for local dev, and set the same vars in Vercel (Project →
# Settings → Environment Variables) for production. NEVER commit real secrets.

# --- Supabase ---
# Project URL is https://<project-ref>.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only, HIGHLY privileged (bypasses RLS). Keep secret. Used to validate keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
# Public-ish keys (not used server-side for auth, kept for reference / client use).
SUPABASE_ANON_KEY=your-anon-jwt
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Admin ---
# Secret used to create/list API keys via /api/admin/keys. Make it long & random.
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Public API key creation controls ---
# Set to false to make key creation admin-only (kill switch during abuse).
PUBLIC_KEY_CREATION=true
# Per-IP rate limits for public key creation.
KEY_RL_PER_IP_HOUR=3
KEY_RL_PER_IP_DAY=10
# Global cap per hour. 0 = disabled (recommended — a global cap 429s everyone
# during a flood). Only set >0 if you understand the trade-off.
KEY_RL_GLOBAL_HOUR=0

# --- Qwen (shared account the API proxies to) ---
# Bearer token from chat.qwen.ai localStorage["token"].
QWEN_TOKEN=your-qwen-token
# Frontend version sent as the required "Version" header (bump if Qwen updates).
QWEN_CLIENT_VERSION=0.2.76
# Expose the model's reasoning as `reasoning_content` in responses (default true).
# Set to false to return only the final answer.
QWEN_SHOW_REASONING=true
# Wipe Qwen's auto-saved memories after each request (keeps the shared account clean).
QWEN_FORGET_MEMORIES=true
# Model used to echo the text before TTS synthesis.
QWEN_TTS_MODEL=qwen3.8-max-preview
# Chat model that drives image/video generation (t2i / image_edit / t2v).
QWEN_MEDIA_MODEL=qwen3-max-2026-01-23
# Secret used to encrypt watermarked-image proxy URLs (AES-GCM). Set to a long
# random string in production so watermark tokens can't be forged. Falls back to
# ADMIN_SECRET if unset.
MEDIA_SECRET=change-me-to-a-long-random-string
# Video generation (qwen-wan). ON by default; set false to disable.
ENABLE_VIDEO_GENERATION=true

# --- Discord login (account system) ---
# Shared secret between this site and the Qwen38_LinkAPI bot. Must match the bot's
# LINK_BOT_SECRET. Long & random. (The bot POLLS the site for DMs, so no BOT_URL /
# public bot server is needed — the bot only makes outbound requests.)
LINK_BOT_SECRET=set-a-long-random-string-matching-the-bot

# --- Cron ---
# Optional secret to protect /api/cron/cleanup (Vercel Cron sends it automatically).
CRON_SECRET=

# --- OneCompiler (onecompiler.com/chat) ---
# Serves only the models that site offers on its Free tier; its "Premium" models
# are not exposed. REQUIRED for the onecompiler models — the endpoint refuses
# anonymous callers ("Please login to use this feature.").
#
# To set it: sign in at https://onecompiler.com/chat, open DevTools > Network,
# send a message, and copy the bearer token from the `authorization` request
# header on POST /api/ai/stream (the value after "Bearer "). It is a session
# credential: keep it out of version control and expect to refresh it when the
# session expires (the proxy reports that as a 401 rather than a vague error).
ONECOMPILER_TOKEN=
# Override the origin, e.g. for testing against a staging deployment.
ONECOMPILER_BASE=

# --- Local development only ---
# If set, this value is accepted as an API key without touching Supabase, so the
# proxy runs with no DB. NEVER set this in production: it is a master key.
DEV_MASTER_KEY=

# --- Abuse controls ---
# Auto-ban an IP (and delete its keys) once it has created this many.
KEY_BLACKLIST_THRESHOLD=12
